# Copiar a .env y completar.
# Solo variables con prefijo VITE_ llegan al cliente: no poner nada secreto aca.

# Clave publica de Web3Forms (https://web3forms.com) para el formulario de contacto.
# Se usa en la fase 5. Es publica por diseno: el servicio la asocia a un mail destino.
VITE_WEB3FORMS_KEY=

# URL canonica del sitio, usada por el SEO y el JSON-LD.
VITE_SITE_URL=https://aberturaspatagonicas.com.ar
